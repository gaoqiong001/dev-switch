{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dev Switch",
  "version": "0.2.0",
  "identifier": "com.dev-switch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dev Switch - 环境检测",
        "fullscreen": false,
        "resizable": true,
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Dev Switch - Local Development Environment Detector",
    "longDescription": "A local development environment detection application",
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGQkI3NTY2REY4NkNBMzQKUldRMHlvYmZablc3dncwOER5Q0JtUytwTDE3T21TSTdBbTR1WWwvRlhPOVZ1aFhHK0FUdEVuaTYK",
      "endpoints": [
        "https://github.com/gaoqiong001/dev-switch/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
